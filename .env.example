# ── Archive Management System — environment template ─────────────────────
# Copy this file to .env and fill in real values. Never commit .env to Git.

# Django secret key — generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to True only for local development; always False in production
DEBUG=False

# Comma-separated list of allowed hostnames (e.g. localhost,127.0.0.1,yourdomain.com)
# Use * only for local development
ALLOWED_HOSTS=localhost,127.0.0.1
