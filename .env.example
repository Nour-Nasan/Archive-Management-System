# ── Archive Management System — environment template ─────────────────────
# Copy this file to .env and fill in real values. Never commit .env to Git.

# Django secret key — generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to True only for local development; always False in production
DEBUG=False

# Comma-separated list of allowed hostnames
# Local dev:  ALLOWED_HOSTS=*
# Production: ALLOWED_HOSTS=your-app-name.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave unset to use local SQLite (development only)
# Render provides this automatically when a PostgreSQL service is linked
DATABASE_URL=postgres://user:password@host:5432/dbname

# Comma-separated trusted origins for CSRF (required for HTTPS on Render)
# Example: https://your-app-name.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com
